# Используем официальный легковесный образ Python [citation:2][citation:8]
FROM python:3.9-slim

# Устанавливаем рабочую директорию внутри контейнера [citation:1]
# Все следующие команды будут выполняться в этой папке
WORKDIR /app

# Копируем нашу локальную папку с библиотекой в контейнер
COPY geometric_lib/ /app/geometric_lib/

# Копируем главный скрипт в контейнер
COPY calculate.py /app/

# (Опционально) Указываем, что контейнер будет слушать команды.
# В данном случае это просто информативно.
# CMD ["python", "calculate.py", "--help"]

# Команда по умолчанию при запуске контейнера без аргументов
# Будет показывать подсказку
CMD ["python", "calculate.py", "--help"]